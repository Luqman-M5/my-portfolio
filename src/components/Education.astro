---
const schools = [
  {
    school:   "Queen Mary University of London",
    location: "London, UK",
    entries: [
      {
        degree: "BSc Computer Science with Industrial Experience",
        period: "Sept 2024 — June 2028",
        grades: [
          { label: "Year 1", score: "78%"},
          { label: "Year 2", score: "70.3%"},
        ],
        modules: [
          "Database Systems (SQL)",
          "Software Engineering (UML, System Design)",
          "Software Engineering Project (Requirements Elicitation, Domain Analysis)",
          "GUI (Data Gathering, User Research)",
        ],
      },
    ],
  },
];
---

<section id="education" class="scroll-mt-28 px-6 py-20 border-t" style="border-color: var(--border);">
  <div class="mx-auto max-w-5xl">

    <p data-reveal class="font-mono text-xs uppercase tracking-widest mb-6" style="color: var(--accent);">
      Education
    </p>
    <h2 data-reveal style="transition-delay: 60ms; color: var(--ink);" class="font-display text-2xl font-semibold sm:text-3xl mb-12">
      Academic background.
    </h2>

    <div class="flex flex-col gap-6">
      {schools.map((s, si) => (
        <div
          data-reveal
          style={`transition-delay: ${si * 100 + 100}ms; background: var(--surface); border: 1px solid var(--border);`}
          class="rounded-2xl overflow-hidden"
        >
          <!-- School header -->
          <div
            class="flex items-center justify-between px-6 py-4 border-b"
            style="border-color: var(--border);"
          >
            <div>
              <p class="font-display font-semibold text-base" style="color: var(--ink);">{s.school}</p>
              <p class="font-mono text-xs mt-0.5" style="color: var(--muted);">{s.location}</p>
            </div>
          </div>

          <!-- Entries -->
          <div class="flex flex-col divide-y" style="border-color: var(--border);">
            {s.entries.map((e) => (
              <div class="px-6 py-5">

                <!-- Degree + period -->
                <div class="flex flex-wrap items-start justify-between gap-2 mb-5">
                  <h3 class="font-display text-lg font-semibold" style="color: var(--ink);">{e.degree}</h3>
                  <p class="font-mono text-xs" style="color: var(--muted);">{e.period}</p>
                </div>

               <!-- Grades -->
<div class="flex flex-col gap-4 mb-6 relative pl-7">
  <div class="absolute left-0 top-2 bottom-2 w-px" style="background: var(--border);"></div>
  {e.grades.map((g) => (
    <div class="relative">
      <span class="absolute -left-[calc(1.1rem+0.5px)] top-1.25 h-3 w-3 rounded-full border-2" style="background: var(--surface); border-color: var(--accent);"></span>
      <div class="flex items-baseline gap-2">
        <span class="font-display text-base font-semibold" style="color: var(--ink);">{g.label}</span>
        <span class="font-display text-base font-semibold" style="color: var(--ink);">{g.score}</span>
      </div>
    </div>
  ))}
</div>

                <!-- Modules -->
                <div>
                  <p class="font-mono text-xs uppercase tracking-widest mb-3" style="color: var(--muted);">Relevant modules</p>
                  <ul class="flex flex-wrap gap-2">
                    {e.modules.map((m) => (
                      <li
                        class="rounded-full border px-3 py-1 font-mono text-xs"
                        style="border-color: var(--border); color: var(--muted); background: var(--bg);"
                      >
                        {m}
                      </li>
                    ))}
                  </ul>
                </div>

              </div>
            ))}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>