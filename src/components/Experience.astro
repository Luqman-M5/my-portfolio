---
const companies = [
  {
    company:  "Queen Mary University of London",
    location: "London, UK",
    roles: [
      {
        role:   "Student Content Creator",
        period: "Oct 2025 — June 2026",
        points: [
          "Producing and editing video content across TikTok, Instagram, Facebook, and YouTube Shorts for QMUL's official channels — sharing authentic student life experiences against briefs set by my manager.",
          "Collaborated with another student creator on scripted video content — working from pre-written dialogue to a managed production brief",
          "Managing end-to-end delivery independently — from scoping to production — against professional briefs set by senior staff.",
          "Working across the QMUL marketing team on cross-functional workflows, building communication and coordination skills in a fast-moving environment.",
        ],
      },
      {
        role:   "Student Demonstrator",
        period: "Oct 2025 — May 2026",
        points: [
          "Running lab sessions for 30–40 students across ECS427U (Professional and Research Practice) and ECS419U (Information Systems Analysis) — breaking down problems that look straightforward on a slide but get complicated fast in practice.",
          "Marking biweekly lab submissions with feedback that explains the thinking behind a better approach, not just a score.",
          "Collaborating with a co-demonstrator to mark major coursework submissions, ensuring consistent and fair feedback across the cohort.",
          "Assisted professors in maintaining structured lab sessions — stepping in on student issues as they arose, keeping the class moving without disrupting the flow.",
        ],
      },
    ],
  },
  {
    company:  "Grain N Grace Private Ltd",
    location: "Kerala, India",
    roles: [
      {
        role:   "Digital Marketing & Analyst Intern",
        period: "Jul 2025 — Sept 2025",
        points: [
          "Identified a 20% budget overspend across Meta and Google Ads — diagnosed the inefficiency channel by channel and delivered a reallocation recommendation that directly influenced budget decisions.",
          "Monitored daily campaign performance across CTR, CPC, and conversion metrics, applying iterative targeting adjustments throughout the internship.",
          "Used Google Analytics 4 to separate high-performing organic content from underperforming pages — findings fed directly into content and promotion strategy.",
          "Produced weekly Excel reports translating cross-channel KPIs into clear summaries for non-technical stakeholders.",
        ],
      },
    ],
  },
];
---

<section id="experience" class="scroll-mt-28 px-6 py-20 border-t" style="border-color: var(--border);">
  <div class="mx-auto max-w-5xl">

    <p data-reveal class="font-mono text-xs uppercase tracking-widest mb-6" style="color: var(--accent);">
      Experience
    </p>
    <h2 data-reveal style="transition-delay: 60ms; color: var(--ink);" class="font-display text-2xl font-semibold sm:text-3xl mb-12">
      Where I have worked.
    </h2>

    <div class="flex flex-col gap-6">
      {companies.map((c, ci) => (
        <div
          data-reveal
          style={`transition-delay: ${ci * 100 + 100}ms; background: var(--surface); border: 1px solid var(--border);`}
          class="rounded-2xl overflow-hidden"
        >
          <!-- Company header -->
          <div
            class="flex items-center justify-between px-6 py-4 border-b"
            style="border-color: var(--border);"
          >
            <div>
              <p class="font-display font-semibold text-xl" style="color: var(--ink);">{c.company}</p>
              <p class="font-mono text-xs mt-0.5" style="color: var(--muted);">{c.location}</p>
            </div>
          </div>

          <!-- Roles -->
          <div class="flex flex-col divide-y" style="border-color: var(--border);">
            {c.roles.map((r) => (
              <div class="px-6 py-5" style="border-color: var(--border);">

                <!-- Role header -->
                <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
                  <div>
                    <h3 class="font-display text-lg font-semibold" style="color: var(--ink);">{r.role}</h3>
                    <p class="font-mono text-xs mt-1" style="color: var(--muted);">{r.period}</p>
                  </div>
                </div>

                <!-- Bullets -->
                <ul class="flex flex-col gap-2">
                  {r.points.map((point) => (
                    <li class="flex gap-3 text-base leading-relaxed" style="color: var(--muted);">
                      <span class="mt-2 h-1 w-1 flex-shrink-0 rounded-full" style="background: var(--accent);"></span>
                      {point}
                    </li>
                  ))}
                </ul>

              </div>
            ))}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>