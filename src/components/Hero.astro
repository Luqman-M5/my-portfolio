---
// add this import at the top of your Hero.astro frontmatter
import { HeroPhoto } from "./HeroPhoto.jsx";
---

<section id="top" class="relative min-h-screen flex flex-col justify-center px-6 pt-28 pb-16 overflow-hidden">

  <!-- Subtle warm grain texture overlay -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-[0.025]"
    style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22200%22 height=%22200%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22/></filter><rect width=%22200%22 height=%22200%22 filter=%22url(%23n)%22/></svg>'); background-size: 200px;"
  ></div>

  <div class="mx-auto w-full max-w-5xl">
    <div class="flex flex-col-reverse gap-10 md:flex-row md:items-center md:justify-between">

      <!-- Left: text content -->
      <div class="flex-1">

        <p data-hero="status" class="mb-5 inline-flex items-center gap-2 rounded-full border px-3 py-1 font-mono text-xs" style="border-color: var(--border); color: var(--muted);">
          <span class="h-1.5 w-1.5 rounded-full" style="background: var(--accent);"></span>
          Upcoming Research Intern at Hybrid
        </p>

        <h1 data-hero="name" class="font-display text-5xl font-semibold leading-tight sm:text-6xl md:text-7xl" style="color: var(--ink);">
          Luqman<br />Muhammed <br />Kunju
        </h1>

        <p data-hero="role" class="font-mono text-base" style="color: var(--accent);">
          Kerala, India
        </p>

        <p data-hero="bio" class="mt-3 max-w-lg text-xl leading-relaxed" style="color: var(--muted);">
          Data & Research Analyst.<br>Computer Science student.
        </p>

    <div class="flex items-center gap-4 mt-4">

  
    <a href="https://github.com/Luqman-M5"
    target="_blank"
    rel="noreferrer"
    aria-label="GitHub"
    style="color: var(--muted); transition: color 0.2s ease;"
    onmouseover="this.style.color='var(--ink)'"
    onmouseout="this.style.color='var(--muted)'"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="30"
      height="30"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
    </svg>
  </a>

  
    <a href="https://www.linkedin.com/in/luqman-muhammed-kunju-3a3471306"
    target="_blank"
    rel="noreferrer"
    aria-label="LinkedIn"
    style="color: var(--muted); transition: color 0.2s ease;"
    onmouseover="this.style.color='var(--ink)'"
    onmouseout="this.style.color='var(--muted)'"
    >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="30"
      height="30"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
    </svg>
  </a>

</div>
      </div>

      <!-- Right: circle photo -->
      <div data-hero="photo" class="flex justify-center md:justify-end">
        <HeroPhoto client:load src="/images/Luqman.jpeg" />
      </div>

    </div>
  </div>
</section>

<script>
  // GSAP hero load-in — the one signature animation.
  // Everything else on the page uses the lightweight IntersectionObserver reveal.
  import { gsap } from "gsap";

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const targets = [
    document.querySelector('[data-hero="status"]'),
    document.querySelector('[data-hero="name"]'),
    document.querySelector('[data-hero="role"]'),
    document.querySelector('[data-hero="bio"]'),
    document.querySelector('[data-hero="links"]'),
    document.querySelector('[data-hero="photo"]'),
  ].filter(Boolean);

  if (reduced) {
    gsap.set(targets, { opacity: 1, y: 0 });
  } else {
    gsap.set(targets, { opacity: 0, y: 18 });
    gsap
      .timeline({ defaults: { duration: 0.75, ease: "power3.out" } })
      .to(targets[0], { opacity: 1, y: 0 }, 0.15)
      .to(targets[1], { opacity: 1, y: 0 }, 0.3)
      .to(targets[2], { opacity: 1, y: 0 }, 0.45)
      .to(targets[3], { opacity: 1, y: 0 }, 0.55)
      .to(targets[4], { opacity: 1, y: 0 }, 0.65)
      .to(targets[5], { opacity: 1, y: 0 }, 0.2);
  }
</script>