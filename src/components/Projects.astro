---
import { Coverflow } from "./motion-ui/Coverflow.jsx";

const projects = [
  {
    title:  "F1 2024 Performance Analytics",
    tools:  ["Python", "FastF1", "pandas", "NumPy", "Matplotlib"],
    href:   "https://github.com/Luqman-M5/F1-EDA",
    points: [
      "EDA across all 24 rounds - analysed lap timing, qualifying results, race performance, and constructor progression throughout the season",
      "Qualifying Consistency Score across average grid position, variance, and gap to pole - top six matched the championship standings.",
      "Cleaned 1,129 laps to 1,034 usable laps, hard tyres outperformed soft tyres through the first 17 laps at Bahrain.",
      "Cumulative constructor points across 24 rounds - McLaren overtook Ferrari at Round 13, then Red Bull by Round 15.",
    ],
  },
  {
    title:  "Customer Segmentation & RFM Analysis",
    tools:  ["PostgreSQL", "Python", "DBeaver", "pandas", "Matplotlib"],
    href:   "https://github.com/Luqman-M5/RFM-Analysis",
    points: [
      "Built RFM scoring across 4,000+ customers - used SQL NTILE(5) to score recency, frequency, and monetary value at scale.",
      "Grouped output into five commercially meaningful segments - Champions drove 45% of revenue while At Risk represented churn exposure.",
      "Found 53% of At-Risk customers concentrated in a $3,017–$3,943 spend band - quantifying the financial value exposed to churn.",
      "Built four Python visualisations - revenue share, recency versus spend, average segment value, and high-value At-Risk customers directly.",
    ],
  },
  {
    title:  "Sales Performance Analysis — Global Superstore",
    tools:  ["Power BI", "DAX", "Power Query"],
    href:   "https://app.notion.com/p/Global-Superstore-Sales-Performance-Analysis-Power-BI-31ade02ef26a80029925c75e20a643a4",
    points: [
      "Built a multi-table Power BI data model across 50,000+ rows using Power Query and DAX, structured to slice any metric by segment, region, or category without the numbers breaking.",
      "Found that Tables sub-category was losing money even on non-discounted orders — separating a unit economics failure from a discounting problem, which have completely different fixes.",
      "Surfaced that the Consumer segment generated 49.8% of revenue but 51.1% of profit, making it structurally more valuable than its revenue share suggested.",
      "Identified a consistent 87% Q4 revenue spike — flagged that the business was not planning inventory, logistics, or staffing around a pattern repeating every single year.",
    ],
  },
  {
    title:  "Marketing Channel Efficiency Analysis",
    tools:  ["Excel", "Power Query", "Tableau"],
    href:   "https://app.notion.com/p/Marketing-Campaign-Performance-Channel-Efficiency-Analysis-311de02ef26a8020b5b9cdf304186383",
    points: [
      "Cleaned a messy multi-channel dataset with nulls, negative spend, and inconsistent dates; built derived metrics — CPA, CPC, CTR, CVR — from raw fields rather than unreliable pre-calculated columns.",
      "Built an Efficiency Index dividing each channel's conversion share by its spend share across $5.36M in budget — Email took 30.8% of spend while returning only 18.7% of conversions.",
      "Used Pivot Tables to quantify the gap between cost and delivery, turning a qualitative feeling that Email underperformed into something concrete enough to argue for reallocation.",
      "Delivered a Tableau dashboard with KPI cards and colour-coded efficiency deltas so the audience could see immediately which channels to scale and which to cut.",
    ],
  },
];
---

<section id="projects" class="scroll-mt-28 px-6 py-20 border-t" style="border-color: var(--border);">
  <div class="mx-auto max-w-5xl">

    <p data-reveal class="font-mono text-xs uppercase tracking-widest mb-6" style="color: var(--accent);">
      Projects
    </p>
    <h2 data-reveal style="transition-delay: 60ms; color: var(--ink);" class="font-display text-2xl font-semibold sm:text-3xl mb-12">
      What I have built.
    </h2>

    <div data-reveal style="transition-delay: 120ms;">
      <Coverflow client:visible projects={projects} />
    </div>

  </div>
</section>