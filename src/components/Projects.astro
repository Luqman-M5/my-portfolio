---

<section id="projects" class="scroll-mt-28 px-6 py-20 border-t" style="border-color: var(--border);">
  <div class="mx-auto max-w-5xl">

    <p data-reveal class="font-mono text-xs uppercase tracking-widest mb-6" style="color: var(--accent);">
      Projects
    </p>
    <h2 data-reveal style="transition-delay: 60ms; color: var(--ink);" class="font-display text-2xl font-semibold sm:text-3xl mb-12">
      What I have built.
    </h2>

    <div class="grid gap-6 sm:grid-cols-2">
      {projects.map((p, i) => (
        <article
          data-reveal
          style={`
            transition-delay: ${i * 80 + 100}ms;
            background: var(--surface);
            border: 1px solid var(--border);
          `}
          class="group flex flex-col rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1"
          onmouseover="this.style.borderColor='var(--accent)'"
          onmouseout="this.style.borderColor='var(--border)'"
        >
          <h3 class="font-display text-lg font-semibold mb-3" style="color: var(--ink);">{p.title}</h3>

          <!-- Tool tags -->
          <div class="flex flex-wrap gap-1.5 mb-4">
            {p.tools.map((t) => (
              <span
                class="rounded-full border px-2.5 py-0.5 font-mono text-[11px]"
                style="border-color: var(--border); color: var(--muted);"
              >
                {t}
              </span>
            ))}
          </div>

          <!-- Bullet points -->
          <ul class="flex flex-col gap-2 flex-1 mb-5">
            {p.points.map((pt) => (
              <li class="flex gap-2.5 text-sm leading-relaxed" style="color: var(--muted);">
                <span class="mt-2 h-1 w-1 flex-shrink-0 rounded-full" style="background: var(--accent-lo); border: 1px solid var(--accent);"></span>
                {pt}
              </li>
            ))}
          </ul>

          <!-- Links -->
          <div class="flex gap-5 font-mono text-sm mt-auto pt-4" style="border-top: 1px solid var(--border);">
            <a
              href={p.href}
              class="transition-colors"
              style="color: var(--accent);"
              onmouseover="this.style.opacity='0.7'"
              onmouseout="this.style.opacity='1'"
            >
              View project
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>